import React from "react";
import { motion } from "framer-motion";

// Import your images (recommended)
// import user1 from "../../assets/user1.jpg";
// import user2 from "../../assets/user2.jpg";

const testimonialsData = [
  {
    text: "Great product! This software has improved our attendance tracking significantly.",
    image: "/images/user1.jpg", // or user1
    name: "John",
    role: "CEO",
  },
  {
    text: "Excellent support and easy to use. Highly recommended!",
    image: "/images/user2.jpg", // or user2
    name: "David",
    role: "Manager",
  },
];

const TestimonialsColumn = ({
  className = "",
  duration = 10,
}) => {
  return (
    <div className={className}>
      <motion.div
        animate={{
          y: "-50%",
        }}
        transition={{
          duration,
          repeat: Infinity,
          repeatType: "loop",
          ease: "linear",
        }}
        className="flex flex-col gap-6 pb-6"
      >
        {[...Array(2)].map((_, index) => (
          <React.Fragment key={index}>
            {testimonialsData.map(({ text, image, name, role }, i) => (
              <div
                key={`${index}-${i}`}
                className="p-10 rounded-3xl border shadow-lg max-w-xs w-full"
              >
                <p>{text}</p>

                <div className="flex items-center gap-2 mt-5">
                  <img
                    src={image}
                    alt={name}
                    width={40}
                    height={40}
                    className="h-10 w-10 rounded-full"
                  />

                  <div>
                    <div className="font-medium">{name}</div>
                    <div>{role}</div>
                  </div>
                </div>
              </div>
            ))}
          </React.Fragment>
        ))}
      </motion.div>
    </div>
  );
};

export default TestimonialsColumn;